                      dataType="System.String"
                      description="O comando SQL a ser executado."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">UPDATE [dbo].[dm_cliente]
   SET
       [desc_cliente] = ?
      ,[cod_estado] = ?
